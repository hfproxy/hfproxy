# Développement local uniquement. Remplacer tous les mots de passe avant tout usage partagé.
POSTGRES_USER=hfproxy
POSTGRES_PASSWORD=hfproxy_dev_password
POSTGRES_DB=hfproxy

# Garage keys for local development only. Replace before sharing the stack.
GARAGE_DEFAULT_ACCESS_KEY=GK0123456789abcdef0123456789abcdef
GARAGE_DEFAULT_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
GARAGE_DEFAULT_BUCKET=hfproxy

# Secret de développement. Utiliser un secret manager en exploitation.
HFPROXY_SESSION_SECRET=dev-only-session-secret-change-before-deployment-32-bytes
HFPROXY_PUBLIC_URL=http://localhost:8080
HFPROXY_ANONYMOUS_PUBLIC_READ=true

# Facultatif : renseigner le jeton HF read-only dans l'environnement.
# HFPROXY_HF_TOKEN=hf_read_only_token

# Facultatif : proxy HTTP, HTTPS, SOCKS4/4a ou SOCKS5 sortant pour Hugging Face.
# HTTP(S) et SOCKS5 acceptent user:password ; SOCKS4 accepte un user ID uniquement.
# HFPROXY_HF_PROXY_URL=socks5://user:password@proxy.example:1080
